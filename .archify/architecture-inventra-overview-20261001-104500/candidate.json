  "cards": [
    {
      "dot": "rose",
      "title": "Zero-Trust Tenant Isolation",
      "items": [
        "X-Tenant-ID header verified against database TenantMemberships per request",
        "EF Core Global Query Filters automatically inject WHERE TenantId = @currentTenantId",
        "Suspended tenants and cross-tenant spoofing requests instantly return HTTP 403 Forbidden"
      ]
    },
    {
      "dot": "emerald",
      "title": "Atomic Platform Provisioning",
      "items": [
        "ACID database transaction guarantees all-or-nothing tenant and admin provisioning",
        "Secure HMAC SHA-256 invitation tokens protect initial administrator onboarding",
        "Role-Based Access Control restricts tenant creation strictly to Platform Admins"
      ]
    },
    {
      "dot": "cyan",
      "title": "Partitioned Cloud Object Storage",
      "items": [
        "All S3 keys strictly namespaced to tenants/{tenantId}/products/{guid}_{file}",
        "Storage operations enforce current tenant context validation before transfer",
        "Cascade deletion cleans up S3 objects upon item deletion"
      ]
    }
  ]
